  <!-- TRAINING TIMELINE -->
  <div class="timeline">
    <div class="section-label">05 — Typical Training Timeline (Frontier Model)</div>
    <div class="tl-item animate delay1">
      <div class="tl-left"><div class="tl-dot"></div><div class="tl-line"></div></div>
      <div class="tl-content">
        <div class="tl-phase">Phase 1</div>
        <div class="tl-name">Data Pipeline & Infrastructure</div>
        <div class="tl-desc">Web crawling, data cleaning, deduplication, tokenization, and building the distributed training infrastructure. Cluster procurement or cloud reservation.</div>
        <span class="tl-duration">2 – 4 months</span>
      </div>
    </div>
    <div class="tl-item animate delay2">
      <div class="tl-left"><div class="tl-dot" style="border-color:var(--accent2)"></div><div class="tl-line"></div></div>
      <div class="tl-content">
        <div class="tl-phase" style="color:var(--accent2)">Phase 2</div>
        <div class="tl-name">Pre-Training</div>
        <div class="tl-desc">Self-supervised next-token prediction across the full training corpus. Runs continuously on thousands of GPUs/TPUs. Frequent checkpointing in case of hardware failures.</div>
        <span class="tl-duration">1 – 6 months</span>
      </div>
    </div>
    <div class="tl-item animate delay1">
      <div class="tl-left"><div class="tl-dot" style="border-color:var(--accent3)"></div><div class="tl-line"></div></div>
